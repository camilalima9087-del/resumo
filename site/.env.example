# Copie para .env (local) ou cadastre estas variaveis no painel da hospedagem.
SECRET_KEY=troque-por-um-texto-longo-e-aleatorio
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha-forte
# Resumo com IA (opcional; gera custo por uso na sua conta Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Em producao com HTTPS:
COOKIE_SECURE=1
BEHIND_PROXY=1
# Pasta onde ficam banco e PDFs (use um disco persistente na hospedagem)
DATA_DIR=./data
MAX_UPLOAD_MB=25
MAX_PAGINAS=150
